{
  "name": "unimate-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "seed:supabase": "tsx --env-file=.env.local scripts/seed-supabase.mts",
    "reset:supabase": "tsx --env-file=.env.local scripts/reset-supabase-demo.mts",
    "snapshots": "tsx scripts/make-snapshots.ts",
    "rebuild:school": "tsx --conditions react-server --env-file=.env.local scripts/rebuild-school.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.118.0",
    "cheerio": "^1.2.0",
    "leaflet": "^1.9.4",
    "next": "16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
